# paper.mplstyle -- publication style for this repo.
#
# Activate with plotting_utils.use_paper_style(), which also registers the
# bundled fonts in fonts/ so the style renders identically on any machine.
#
# Sized for print: type is 6-8 pt, so make figures at their FINAL column width
# (plotting_utils.figsize) and never rescale them in the manuscript.

# ---- type -----------------------------------------------------------------
font.family          : sans-serif
# Source Sans 3 is bundled in fonts/ (OFL). Arial is the journal-safe fallback;
# avoid the macOS .ttc faces (Avenir, Helvetica Neue): matplotlib only indexes
# one weight from a collection, so bold either does nothing or is all you get.
font.sans-serif      : Source Sans 3, Arial, DejaVu Sans
font.size            : 7
axes.titlesize       : 8
axes.labelsize       : 7
xtick.labelsize      : 6
ytick.labelsize      : 6
legend.fontsize      : 6
legend.title_fontsize: 7
figure.titlesize     : 9
figure.titleweight   : normal
axes.titleweight     : normal
axes.titlelocation   : center      # decided 2026-09-21: centred, not left
axes.titlepad        : 4
axes.labelpad        : 2.5
# math in the same sans face as the text (s_t, ±, Δ all match the labels)
mathtext.fontset     : custom
mathtext.rm          : Source Sans 3
mathtext.it          : Source Sans 3:italic
mathtext.bf          : Source Sans 3:bold
mathtext.default     : it

# ---- ink: near-black instead of pure black, softer on white ----------------
text.color           : 1c1c1c
axes.labelcolor      : 1c1c1c
axes.edgecolor       : 1c1c1c
xtick.color          : 1c1c1c
ytick.color          : 1c1c1c

# ---- axes ------------------------------------------------------------------
axes.spines.top      : False
axes.spines.right    : False
axes.linewidth       : 0.6
axes.grid            : False
axes.axisbelow       : True
axes.xmargin         : 0.02
axes.ymargin         : 0.04
axes.autolimit_mode  : data
axes.formatter.use_mathtext : True
axes.formatter.limits: -3, 4
axes.formatter.useoffset : False

# ---- ticks -----------------------------------------------------------------
xtick.direction      : out
ytick.direction      : out
xtick.major.size     : 2.5
ytick.major.size     : 2.5
xtick.minor.size     : 1.2
ytick.minor.size     : 1.2
xtick.major.width    : 0.6
ytick.major.width    : 0.6
xtick.minor.width    : 0.4
ytick.minor.width    : 0.4
xtick.major.pad      : 2
ytick.major.pad      : 2
xtick.minor.visible  : False
ytick.minor.visible  : False

# ---- marks -----------------------------------------------------------------
# Fixed categorical order (plotting_utils.PALETTE): navy, salmon, teal, amber,
# slate-violet, rose. Grey is NOT a series colour (it is MUTED, for reference
# marks). Checked 2026-09-21 with colorspacious: every pair >= 15 dE for normal
# vision and >= 8 under deuteran/protan/tritanomaly, so line style stays the
# second encoding. Series colours follow the entity: pass colours explicitly
# for anything with a name; the cycle is for unnamed things.
axes.prop_cycle      : cycler('color', ['0e3b5c', 'd8897b', '238b7e', 'edb060', '5e4f6d', 'c25b6b'])
lines.linewidth      : 1.2
lines.markersize     : 3
lines.markeredgewidth: 0
lines.solid_capstyle : round
lines.dash_capstyle  : round
patch.linewidth      : 0.6
patch.edgecolor      : none
patch.force_edgecolor: False
hatch.linewidth      : 0.5
errorbar.capsize     : 0
scatter.marker       : o
image.cmap           : paper_seq
image.interpolation  : nearest
boxplot.flierprops.markersize : 2
boxplot.medianprops.color     : 1c1c1c

# ---- legend ----------------------------------------------------------------
legend.frameon       : False
legend.handlelength  : 1.4
legend.handletextpad : 0.5
legend.borderaxespad : 0.3
legend.labelspacing  : 0.3
legend.columnspacing : 1.0
legend.markerscale   : 1.0

# ---- figure & layout -------------------------------------------------------
figure.dpi           : 150
figure.figsize       : 3.5, 2.2
figure.facecolor     : white
# Constrained layout is NOT switched on globally: the existing figure scripts
# were laid out with tight_layout(rect=...) and hand-set gridspec spacing, and
# the two engines fight. Opt in per figure with plt.subplots(layout="constrained")
# or plt.figure(layout="constrained"); these pads then apply.
figure.constrained_layout.use : False
figure.constrained_layout.h_pad : 0.03
figure.constrained_layout.w_pad : 0.03
figure.constrained_layout.hspace : 0.04
figure.constrained_layout.wspace : 0.04

# ---- output ----------------------------------------------------------------
savefig.dpi          : 300
savefig.bbox         : tight
savefig.pad_inches   : 0.02
savefig.facecolor    : white
savefig.transparent  : False
svg.fonttype         : none
pdf.fonttype         : 42
ps.fonttype          : 42

# ---- fidelity --------------------------------------------------------------
# No path simplification: vector output keeps every vertex of every trace.
path.simplify        : False
agg.path.chunksize   : 0
